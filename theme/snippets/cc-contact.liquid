{%- comment -%}
  Floating contact button + slide-out panel.
  Rendered once from layout/theme.liquid, just before </body>.
{%- endcomment -%}
{%- liquid
  assign cc_text_display = '(310) 363-0481'
  assign cc_text_number = '+13103630481'
  assign cc_appt_email = 'chris@chronocandy.com'
-%}
<style>
  .cc-contact-fab{position:fixed;right:20px;bottom:20px;z-index:60;width:60px;height:60px;border-radius:50%;border:1px solid rgba(255,255,255,.14);background:#0b1530;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 10px 30px rgba(5,10,30,.35);font:600 18px/1 'DM Sans',sans-serif;letter-spacing:.04em;transition:transform .2s ease,box-shadow .2s ease}
  .cc-contact-fab:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(5,10,30,.45)}
  .cc-contact-fab:focus-visible,.cc-contact a:focus-visible,.cc-contact__close:focus-visible{outline:2px solid #4f6ef7;outline-offset:3px}
  .cc-contact-overlay{position:fixed;inset:0;z-index:61;background:rgba(5,10,30,.45);opacity:0;pointer-events:none;transition:opacity .25s ease}
  .cc-contact{position:fixed;top:0;right:0;bottom:0;z-index:62;width:min(440px,100vw);background:#f7f8fb;color:#0b1530;transform:translateX(100%);transition:transform .3s ease;display:flex;flex-direction:column;font-family:'DM Sans',sans-serif;box-shadow:-20px 0 40px rgba(5,10,30,.2)}
  .cc-contact-open .cc-contact{transform:none}
  .cc-contact-open .cc-contact-overlay{opacity:1;pointer-events:auto}
  .cc-contact__head{display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid #e3e6ee}
  .cc-contact__brand{font-weight:700;letter-spacing:.18em;text-transform:uppercase;font-size:15px}
  .cc-contact__close{width:40px;height:40px;border-radius:50%;border:1px solid #d9dde7;background:#fff;color:#0b1530;cursor:pointer;font-size:20px;line-height:1}
  .cc-contact__body{padding:28px 24px;overflow-y:auto;flex:1}
  .cc-contact__title{font-size:34px;line-height:1.1;font-weight:500;margin:0 0 10px}
  .cc-contact__title em{color:#4f6ef7;font-style:italic}
  .cc-contact__lead{font-size:16px;line-height:1.5;color:#4a5165;margin:0 0 24px}
  .cc-contact__card{display:flex;align-items:center;gap:16px;padding:20px;border-radius:16px;text-decoration:none;margin-bottom:14px;transition:transform .15s ease}
  .cc-contact__card:hover{transform:translateY(-1px)}
  .cc-contact__card--primary{background:#0b1530;color:#fff}
  .cc-contact__card--plain{background:#fff;color:#0b1530;border:1px solid #e3e6ee}
  .cc-contact__icon{flex:none;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center}
  .cc-contact__card--primary .cc-contact__icon{background:#4f6ef7}
  .cc-contact__card--plain .cc-contact__icon{background:#eef1fb;color:#4f6ef7}
  .cc-contact__label{display:block;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;opacity:.75;margin-bottom:4px}
  .cc-contact__card--primary .cc-contact__label{color:#9fb1ff;opacity:1}
  .cc-contact__value{display:block;font-size:20px;font-weight:600}
  .cc-contact__hint{display:block;font-size:14px;opacity:.7;margin-top:4px}
  .cc-contact__arrow{margin-left:auto;opacity:.6}
  .cc-contact__foot{padding:16px 24px;border-top:1px solid #e3e6ee;font-size:14px;color:#7a8196}
  @media (max-width:480px){.cc-contact-fab{right:14px;bottom:14px;width:54px;height:54px;font-size:16px}.cc-contact__title{font-size:28px}}
  @media (prefers-reduced-motion:reduce){.cc-contact,.cc-contact-overlay,.cc-contact-fab{transition:none}}
</style>

<button type="button" class="cc-contact-fab" aria-haspopup="dialog" aria-controls="cc-contact" aria-label="Contact {{ shop.name }}" data-cc-contact-open>CC</button>
<div class="cc-contact-overlay" data-cc-contact-close></div>
<aside id="cc-contact" class="cc-contact" role="dialog" aria-modal="true" aria-labelledby="cc-contact-title" aria-hidden="true" tabindex="-1">
  <div class="cc-contact__head">
    <span class="cc-contact__brand">{{ shop.name }}</span>
    <button type="button" class="cc-contact__close" aria-label="Close" data-cc-contact-close>&times;</button>
  </div>
  <div class="cc-contact__body">
    <h2 id="cc-contact-title" class="cc-contact__title">Questions about <em>a watch?</em></h2>
    <p class="cc-contact__lead">Text us a photo, a model number, or a question and we'll get back to you.</p>

    <a class="cc-contact__card cc-contact__card--primary" href="sms:{{ cc_text_number }}">
      <span class="cc-contact__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
      </span>
      <span>
        <span class="cc-contact__label">Fastest reply</span>
        <span class="cc-contact__value">Text {{ cc_text_display }}</span>
        <span class="cc-contact__hint">Send a photo, model number, or question</span>
      </span>
      <span class="cc-contact__arrow" aria-hidden="true">&rarr;</span>
    </a>

    <a class="cc-contact__card cc-contact__card--plain" href="mailto:{{ cc_appt_email }}?subject={{ 'Appointment request' | url_encode }}">
      <span class="cc-contact__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
      </span>
      <span>
        <span class="cc-contact__label">Book an appointment</span>
        <span class="cc-contact__value">Email us</span>
        <span class="cc-contact__hint">{{ cc_appt_email }}</span>
      </span>
      <span class="cc-contact__arrow" aria-hidden="true">&rarr;</span>
    </a>
  </div>
  <div class="cc-contact__foot">Los Angeles</div>
</aside>

<script>
  (function () {
    var root = document.documentElement;
    var panel = document.getElementById('cc-contact');
    var opener = document.querySelector('[data-cc-contact-open]');
    if (!panel || !opener) return;
    function open() {
      root.classList.add('cc-contact-open');
      panel.setAttribute('aria-hidden', 'false');
      opener.setAttribute('aria-expanded', 'true');
      panel.focus();
    }
    function close() {
      root.classList.remove('cc-contact-open');
      panel.setAttribute('aria-hidden', 'true');
      opener.setAttribute('aria-expanded', 'false');
      opener.focus();
    }
    opener.addEventListener('click', open);
    document.querySelectorAll('[data-cc-contact-close]').forEach(function (el) { el.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && root.classList.contains('cc-contact-open')) close();
    });
  })();
</script>
